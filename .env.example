# Supabase Configuration
# À récupérer sur votre tableau de bord Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# Web Push Notifications (Clés VAPID)
# À générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre_cle_vapid_publique
VAPID_PRIVATE_KEY=votre_cle_vapid_privee
VAPID_SUBJECT=mailto:votre-email@exemple.com

# Clé secrète pour sécuriser la route cron de rappel (/api/cron/check-reminders)
CRON_SECRET=votre_token_secret_cron
